AUTH0_DOMAIN=
AUTH0_AUDIENCE=
PORT=3001
MCP_SERVER_URL=http://localhost:3001

# Uploadcare public key used for server-side upload-from-URL image ingest.
# Product images are ingested into Uploadcare and delivered from its single
# allowlistable CDN origin. Defaults to the project key c92034e89436168ebefd
# when unset.
UPLOADCARE_PUBLIC_KEY=

# Auth0 Management API credentials (from Auth0 Dashboard → Applications → APIs → Auth0 Management API)
# Create Auth0 App like PayAlly Management then get client ID and Client Secret
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Management API audience for the M2M client-credentials token. Keep ALL Auth0
# HTTP calls on the custom domain (AUTH0_DOMAIN) so the token issuer matches;
# only the AUDIENCE must be the CANONICAL tenant Management API identifier
# (e.g. https://dev-xxxx.us.auth0.com/api/v2/). Using the custom-domain audience
# gives 403 "Service not enabled". Defaults to https://${AUTH0_DOMAIN}/api/v2/.
AUTH0_MGMT_AUDIENCE=

# =============================================================================
# BRAND IDENTITY — set once per deployed instance so this MCP server presents
# itself as that brand (NOT PayAlly). Collected by the PayAlly Partner portal
# at merchant onboarding and injected as env at deploy time.
#
# HARD RULE: never expose PAYPAL_MERCHANT_ID (or any PayAlly internal) to the
# customer or their AI agent. The customer only ever sees this brand.
# =============================================================================

# The brand's display name. Used as the MCP server name and in every tool
# description so the agent says "the Nike store", never "PayAlly".
BRAND_NAME=Nike

# What the brand calls its storefront ("store", "boutique", "shop", ...).
BRAND_STORE_NOUN=store

# One-line brand voice/tone hint woven into descriptions. Optional.
BRAND_VOICE=Athletic, performance-driven, premium.

# What the brand sells, as natural nouns (comma- or semicolon-separated). Used
# to phrase tool descriptions so the agent speaks the brand's language, e.g.
# "Search the Nike catalog for sneakers, running shoes, training gear...".
BRAND_PRODUCT_NOUNS=sneakers, running shoes, training gear, athletic apparel

# High-level category hints (comma- or semicolon-separated). FLAVOR ONLY for
# phrasing — the real categories always come from the live catalog API, so keep
# this short. Optional.
BRAND_CATEGORY_HINTS=Athletic Shoes, Running, Training, Sneakers
